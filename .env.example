# Optional: Connect Supabase for realtime sync across iPhone PWA, MacBook & PC.
# Without these keys, CatyBoard works immediately in Local-First mode on your device.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: Spotify OAuth Client ID (for browsing your personal playlists & Premium Web Playback).
# Note: Pasting any Spotify or YouTube link works immediately even without this key!
NEXT_PUBLIC_SPOTIFY_CLIENT_ID=
